@{
    ViewData["Title"] = "病人資訊清單";
    List<SelectListItem> GenderCodeList = (List<SelectListItem>)ViewBag.GenderCodeList;
    PatientViewModel PatientViewModel = (PatientViewModel)ViewBag.PatientViewModel;
    var dischargeStatusOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "請下拉選單", Value = "", Selected = string.IsNullOrEmpty(PatientViewModel.DischargeStatus) },
        new SelectListItem { Text = "治癒", Value = "治癒", Selected = PatientViewModel.DischargeStatus == "治癒" },
        new SelectListItem { Text = "病情改善", Value = "病情改善", Selected = PatientViewModel.DischargeStatus == "病情改善" },
        new SelectListItem { Text = "不變", Value = "不變", Selected = PatientViewModel.DischargeStatus == "不變" },
        new SelectListItem { Text = "轉院", Value = "轉院", Selected = PatientViewModel.DischargeStatus == "轉院" },
        new SelectListItem { Text = "死亡", Value = "死亡", Selected = PatientViewModel.DischargeStatus == "死亡" }
    };
}

<div id="patientForm" class="patient-page">
    <div class="model-header">
        <p class="eyebrow">Patient Management</p>
        <h1 class="display-4">病人資訊清單</h1>
        <p class="section-subtitle">整合搜尋、列表與編輯的清爽版面</p>
    </div>

    <div class="card-panel patient-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <p class="eyebrow mb-1">搜尋條件</p>
                <h2 class="section-title mb-0">查詢病人</h2>
                <p class="section-subtitle">輸入常用欄位後點擊查詢或新增</p>
            </div>
            <div class="section-actions d-flex flex-wrap">
                <button type="button" class="btn btn-success" onclick="Add()">新增</button>
                <button type="button" class="btn btn-outline-primary" onclick="Search()">查詢</button>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-3 col-sm-6">
                <label class="form-label">病歷號</label>
                <input type="text" class="form-control" id="SearchPatientId" name="SearchPatientId" value="" placeholder="可輸入部分病歷號">
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="form-label">身分證字號</label>
                <input type="text" class="form-control" id="SearchIdNo" name="SearchIdNo" value="" placeholder="輸入全碼或後四碼">
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="form-label">姓</label>
                <input type="text" class="form-control" id="SearchFamilyName" name="SearchFamilyName" value="" placeholder="例：王">
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="form-label">名</label>
                <input type="text" class="form-control" id="SearchGivenName" name="SearchGivenName" value="" placeholder="例：小明">
            </div>
        </div>
    </div>

    <div class="card-panel table-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <p class="eyebrow mb-1">結果</p>
                <h2 class="section-title mb-0">病人清單</h2>
                <p class="section-subtitle">固定欄寬並可橫向捲動，重點欄位置頂</p>
            </div>
        </div>

        <div class="patient-table-wrapper">
            <table class="table patient-table table-striped align-middle" id="patientList" style="display: none">
                <thead style="vertical-align: middle;">
                    <tr>
                        <th></th>
                        <th>病歷號</th>
                        <th>姓名</th>
                        <th>性別</th>
                        <th>身分證字號</th>
                        <th>生日</th>
                        <th>是否住院</th>
                        <th>入院日期</th>
                        <th>出院日期</th>
                        <th>出院狀況</th>
                        <th>轉院院名</th>
                        <th>匯出FHIR</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div>
            <span id="noData" class="empty-note" style="display: none">查無資料</span>
        </div>
    </div>

<div id="editForm" class="card-panel form-panel" style="display: none">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <p class="eyebrow mb-1">編輯 / 新增</p>
                <h2 class="section-title mb-0">病人資料</h2>
                <p class="section-subtitle">完整欄位輸入，動態顯示住院與轉院資訊</p>
            </div>
        </div>

        <div class="row g-3" style="display: none">
            <div class="form-group col-md-12">
                <label class="control-label">病歷號</label>
                <input type="text" class="form-control" id="PatientId" name="PatientId" value="@PatientViewModel.PatientId" placeholder="系統自動帶入">
            </div>
        </div>
        <div class="row g-3">
            <div class="form-group col-md-6">
                <label class="control-label">姓</label>
                <input type="text" class="form-control" id="FamilyName" name="FamilyName" value="@PatientViewModel.FamilyName" placeholder="例：王">
            </div>
            <div class="form-group col-md-6">
                <label class="control-label">名</label>
                <input type="text" class="form-control" id="GivenName" name="GivenName" value="@PatientViewModel.GivenName" placeholder="例：小明">
            </div>
        </div>
        <div class="row g-3">
            <div class="form-group col-md-3">
                <label class="control-label">身分證字號</label>
                <input type="text" class="form-control" id="IdNo" name="IdNo" value="@PatientViewModel.IdNo" placeholder="A123456789">
            </div>
            <div class="form-group col-md-3">
                <label class="control-label">生日</label>
                <input type="date" class="form-control" id="Birthday" name="Birthday" value="@(PatientViewModel.Birthday == DateTime.MinValue ? "" : PatientViewModel.Birthday.ToString("yyyy-MM-dd"))">
            </div>
            <div class="form-group col-md-3">
                <label>性別</label>
                @Html.DropDownList("group", GenderCodeList, "請下拉選單", new{ @class = "form-control", id = "Gender" })
            </div>
            <div class="form-group col-md-3">
                <label class="control-label">聯絡電話</label>
                <input type="text" class="form-control" id="Telecom" name="Telecom" value="@PatientViewModel.Telecom" placeholder="手機或市話">
            </div>
        </div>
        <div class="row g-3">
            <div class="form-group col-md-12">
                <label class="control-label">住址</label>
                <textarea class="form-control" rows="3" id="Address" name="Address" placeholder="例：台北市中正區仁愛路一段">@PatientViewModel.Address</textarea>
            </div>
        </div>

        <div class="row g-3">
            <div class="form-group col-md-3">
                <label class="control-label">是否住院</label>
                <select class="form-control" id="IsHospitalized" name="IsHospitalized" onchange="toggleHospitalized(this.value)">
                    <option value="">請下拉選單</option>
                    <option value="Y" selected="@(PatientViewModel.IsHospitalized == "Y")">是</option>
                    <option value="N" selected="@(PatientViewModel.IsHospitalized == "N")">否</option>
                </select>
            </div>
        </div>

        <div id="hospitalizedDateRow" class="row g-3" style="display:@(PatientViewModel.IsHospitalized == "Y" ? "flex" : "none");">
            <div class="form-group col-md-3">
                <label class="control-label">入院日期</label>
                <input type="date" class="form-control" id="AdmitDate" name="admitDate"
                       value="@(PatientViewModel.AdmitDate.HasValue? PatientViewModel.AdmitDate.Value.ToString("yyyy-MM-dd") : "")">
            </div>

            <div class="form-group col-md-3">
                <label class="control-label">出院日期</label>
                <input type="date" class="form-control" id="DischargeDate" name="dischargeDate"
                       value="@(PatientViewModel.DischargeDate.HasValue? PatientViewModel.DischargeDate.Value.ToString("yyyy-MM-dd") : "")">
            </div>
        </div>

        <div class="row g-3">
            <div class="form-group col-md-3">
                <label class="control-label">出院狀況</label>
                @Html.DropDownList("DischargeStatus", dischargeStatusOptions, new { @class = "form-control", onchange = "toggleTransferHospital(this.value)", id = "DischargeStatus" })
                <div id="transferHospitalRow" class="form-group mt-2" style="display: @(PatientViewModel.DischargeStatus == "轉院" ? "block" : "none");">
                    <label class="control-label">轉院院名</label>
                    <input type="text" class="form-control" id="TransferHospital" name="transferHospital" value="@PatientViewModel.TransferHospital" placeholder="轉往醫院名稱">
                </div>
            </div>
        </div>

        <div class="action-bar d-flex justify-content-end">
            <button type ="button" class="btn btn-primary btn-sm" id="submitButton" style="display: none" onclick="Submit()">儲存</button>
        </div>
    </div>
</div>
<script>
    function toggleHospitalized(value) {
        const row = document.getElementById("hospitalizedDateRow");
        const admit = document.getElementById("AdmitDate");
        const discharge = document.getElementById("DischargeDate");

        if (value === "Y") {
            row.style.display = "flex";
        } else {
            row.style.display = "none";
            // 清空日期
            admit.value = "";
            discharge.value = "";
        }
    }
</script>

<script>
        // 根據出院狀況顯示或隱藏轉院欄位
        function toggleTransferHospital(value) {
            const row = document.getElementById("transferHospitalRow");
            row.style.display = value === "轉院" ? "block" : "none";
        }
</script>
<script>
    const renderHospitalizedBadge = (value) => {
        if (value === "Y") {
            return '<span class="badge-chip success">住院</span>';
        }
        if (value === "N") {
            return '<span class="badge-chip muted">未住院</span>';
        }
        return '<span class="badge-chip muted">N/A</span>';
    };

    const renderDischargeBadge = (value) => {
        switch (value) {
            case "治癒":
            case "病情改善":
                return `<span class="badge-chip success">${value}</span>`;
            case "轉院":
                return `<span class="badge-chip info">${value}</span>`;
            case "不變":
                return `<span class="badge-chip warning">${value}</span>`;
            case "死亡":
                return `<span class="badge-chip danger">${value}</span>`;
            default:
                return `<span class="badge-chip muted">${value || "N/A"}</span>`;
        }
    };

    function showToast(message, type = "info") {
        let holder = document.getElementById("toast-holder");
        if (!holder) {
            holder = document.createElement("div");
            holder.id = "toast-holder";
            document.body.appendChild(holder);
        }

        const toast = document.createElement("div");
        toast.className = `toast-banner ${type}`;
        toast.innerText = message;
        holder.appendChild(toast);

        setTimeout(() => {
            toast.classList.add("show");
        }, 10);

        setTimeout(() => {
            toast.classList.remove("show");
            setTimeout(() => toast.remove(), 200);
        }, 2600);
    }

    function Search() {
        $.ajax({
            url: '@Url.Content("~/Patient/Search")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientId: document.getElementById("SearchPatientId").value,
                idNo: document.getElementById("SearchIdNo").value,
                familyName: document.getElementById("SearchFamilyName").value,
                givenName: document.getElementById("SearchGivenName").value,
                admitDate: document.querySelector('input[name="admitDate"]').value,
                dischargeDate: document.querySelector('input[name="dischargeDate"]').value,
                dischargeStatus: document.getElementById("DischargeStatus").value,
                transferHospital: document.querySelector('input[name="transferHospital"]') ? document.querySelector('input[name="transferHospital"]').value : ""
            },
            success: function (result) {
                if (Array.isArray(result) && result.length > 0) {
                    document.getElementById('patientList').style.display = "block";
                    document.getElementById('noData').style.display = "none";

                    SearchList(result);
                } else {
                    showToast("查無資料，請調整條件再試", "warning");
                    document.getElementById('patientList').style.display = "none";
                    document.getElementById('noData').style.display = "block";
                }
            },
            error: function (err) {
                showToast(err.responseText || "查詢失敗，請稍後再試", "danger");
            }
        });
    };

    function SearchList(result) {
        var table = document.getElementById("patientList");
        
        if (table.rows.length > 1 ) {
            for (var i = 1; i < table.rows.length;) {
                table.deleteRow(i);
            }
        }

        for (let i = 0; i < result.length; i++) {
            var row = table.insertRow(i + 1);
            
            var cell1 = row.insertCell(0);
            var cell2 = row.insertCell(1);
            var cell3 = row.insertCell(2);
            var cell4 = row.insertCell(3);
            var cell5 = row.insertCell(4);
            var cell6 = row.insertCell(5);
            var cell7 = row.insertCell(6); // 👈 IsHospitalized
            var cell8 = row.insertCell(7); // 👈 AdmitDate
            var cell9 = row.insertCell(8); // 👈 DischargeDate
            var cell10 = row.insertCell(9); // 👈 DischargeStatus
            var cell11 = row.insertCell(10); // 👈 TransferHospital
            var cell12 = row.insertCell(11); // 👈 ExportFHIR

            cell1.innerHTML = `<button type="button" class="btn btn-warning" onClick="Update(` + result[i].patientId + ` ) ">修改</button>
                               <button type="button" class="btn btn-danger" onClick="Delete(` + result[i].patientId + `)">刪除</button>`;
            cell2.innerHTML = result[i].patientId;
            cell3.innerHTML = result[i].familyName + result[i].givenName;
            cell4.innerHTML = (result[i].gender == 'M') ? '男' : '女';
            cell5.innerHTML = result[i].idNo;
            cell6.innerHTML = new Date(result[i].birthday).toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });

            // 是否住院
            cell7.innerHTML = renderHospitalizedBadge(result[i].isHospitalized); // 👈 調整 IsHospitalized

            // 轉換日期格式，如果日期是 MinValue 則顯示 N/A
            const formatIfValid = (dateString) => {
                const date = new Date(dateString);
                // 檢查是否是有效的日期 (非 0001/01/01 且非無效日期)
                if (date.getFullYear() > 1 && !isNaN(date)) {
                    return date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
                }
                return 'N/A';
            };

            cell8.innerHTML = formatIfValid(result[i].admitDate); // 👈 AdmitDate
            cell9.innerHTML = formatIfValid(result[i].dischargeDate); // 👈 DischargeDate
            cell10.innerHTML = renderDischargeBadge(result[i].dischargeStatus);
            cell11.innerHTML = result[i].transferHospital ? result[i].transferHospital : 'N/A';

            // 最右邊匯出FHIR按鈕
            cell12.innerHTML = `<button type="button" class="btn btn-info" onClick="ExportFHIR(` + result[i].patientId + `)">匯出FHIR</button>`; // 👈 ExportFHIR
        }
    };

    function Submit(){
        var dischargeStatus = document.getElementById("DischargeStatus").value;
        var transferHospitalInput = document.querySelector('input[name="transferHospital"]');
        var transferHospital = transferHospitalInput ? transferHospitalInput.value : "";
        if (dischargeStatus !== "轉院") {
            transferHospital = "";
        }

        var formData = {
            PatientId: document.getElementById("PatientId").value,
            IdNo: document.getElementById("IdNo").value,
            Active: true,
            FamilyName: document.getElementById("FamilyName").value,
            GivenName: document.getElementById("GivenName").value,
            Telecom: document.getElementById("Telecom").value,
            Gender: document.getElementById("Gender").value,
            Birthday: document.getElementById("Birthday").value,
            Address: document.getElementById("Address").value,
            IsHospitalized: document.getElementById("IsHospitalized").value,
            AdmitDate: document.getElementById("AdmitDate").value,
            DischargeDate: document.getElementById("DischargeDate").value,
            DischargeStatus: dischargeStatus,
            TransferHospital: transferHospital
        }

        console.log('formData', formData);

        $.ajax({
            url: '@Url.Content("~/Patient/Save")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientViewModel: formData
            },
            success: function (result) {
                if (result) {
                    document.getElementById('editForm').style.display = "none";
                    document.getElementById('submitButton').style.display = "none";

                    Search();
                    showToast("儲存成功", "success");
                    return;
                }
                showToast(result.Error || "儲存失敗", "danger");
            },
            error: function (err) {
                showToast(err.responseText || "儲存失敗，請稍後再試", "danger");
            }
        });
    };

    function Add() {
        document.getElementById('editForm').style.display = "block";
        document.getElementById('submitButton').style.display = "block";

        document.getElementById("PatientId").value = 0;
        document.getElementById("FamilyName").value = "";
        document.getElementById("GivenName").value = "";
        document.getElementById("IdNo").value = "";
        document.getElementById("Birthday").value = new Date().toLocaleDateString('en-CA');
        document.getElementById("Gender").value = "";
        document.getElementById("Telecom").value = "";
        document.getElementById("Address").value = "";
        document.getElementById("IsHospitalized").value = ""; // 👈 初始為空（請下拉選單）
        toggleHospitalized(""); // 👈 隱藏入院/出院日期
        document.getElementById("DischargeStatus").value = "";
        toggleTransferHospital("");
    };
    function Update(id) {
        $.ajax({
            url: '@Url.Content("~/Patient/Search")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientId: id
            },
            success: function (result) {
                if (result) {
                    document.getElementById('editForm').style.display = "block";
                    document.getElementById('submitButton').style.display = "block";

                    document.getElementById("PatientId").value = result[0].patientId;
                    document.getElementById("FamilyName").value = result[0].familyName;
                    document.getElementById("GivenName").value = result[0].givenName;
                    document.getElementById("IdNo").value = result[0].idNo;
                    document.getElementById("Birthday").value = new Date(result[0].birthday).toLocaleDateString('en-CA');
                    document.getElementById("Gender").value = result[0].gender;
                    document.getElementById("Telecom").value = result[0].telecom;
                    document.getElementById("Address").value = result[0].address;
                    document.getElementById("IsHospitalized").value = result[0].isHospitalized;
                    document.getElementById("AdmitDate").value = new Date(result[0].admitDate).toLocaleDateString('en-CA');
                    document.getElementById("DischargeDate").value = new Date(result[0].dischargeDate).toLocaleDateString('en-CA');
                    document.getElementById("DischargeStatus").value = result[0].dischargeStatus;
                    toggleTransferHospital(result[0].dischargeStatus);
                    if (result[0].dischargeStatus === "轉院") {
                        document.getElementById("TransferHospital").value = result[0].transferHospital;
                    }
                    return;
                }
                showToast(result.message || "查詢失敗", "danger");
            },
            error: function (err) {
                showToast(err.responseText || "查詢失敗，請稍後再試", "danger");
            }
        });
    };
    function Delete(id) {
       $.ajax({
            url: '@Url.Content("~/Patient/Delete")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientId: id
            },
            success: function (result){
                if(result){
                    Search();
                    showToast("刪除成功", "success");
                    return;
                }
                showToast(result.message || "刪除失敗", "danger");
            },
            error: function(err){
                showToast(err.responseText || "刪除失敗，請稍後再試", "danger");
            }
        });
    };

    function ExportFHIR(id) {
        // 直接用 GET 下載 FHIR JSON 檔
        window.location.href = '@Url.Content("~/Patient/ExportFHIR")' + '?patientId=' + id;
    }

</script>
