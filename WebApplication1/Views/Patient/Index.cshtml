@{
    ViewData["Title"] = "病人資訊清單";
    List<SelectListItem> GenderCodeList = (List<SelectListItem>)ViewBag.GenderCodeList;
    PatientViewModel PatientViewModel = (PatientViewModel)ViewBag.PatientViewModel;
    var dischargeStatusOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "請下拉選單", Value = "", Selected = string.IsNullOrEmpty(PatientViewModel.DischargeStatus) },
        new SelectListItem { Text = "治癒", Value = "治癒", Selected = PatientViewModel.DischargeStatus == "治癒" },
        new SelectListItem { Text = "病情改善", Value = "病情改善", Selected = PatientViewModel.DischargeStatus == "病情改善" },
        new SelectListItem { Text = "不變", Value = "不變", Selected = PatientViewModel.DischargeStatus == "不變" },
        new SelectListItem { Text = "轉院", Value = "轉院", Selected = PatientViewModel.DischargeStatus == "轉院" },
        new SelectListItem { Text = "死亡", Value = "死亡", Selected = PatientViewModel.DischargeStatus == "死亡" }
    };
}

<div id="patientForm">
    <div class="model-header">
        <h1 class="display-4">病人資訊清單</h1>
    </div>
    <div class="modal-body">

        @* Search Section *@
        <div class="row">
            <div class="form-inline col-md-3">
                <label class="control-label">病歷號</label>
                <input type="text" class="form-control" id="SearchPatientId" name="SearchPatientId" value="">
            </div>
            <div class="form-inline col-md-3">
                <label class="control-label">身分證字號</label>
                <input type="text" class="form-control" id="SearchIdNo" name="SearchIdNo" value="">
            </div>
            <div class="form-inline col-md-3">
                <label class="control-label">姓</label>
                <input type="text" class="form-control" id="SearchFamilyName" name="SearchFamilyName" value="">
            </div>
            <div class="form-inline col-md-3">
                <label class="control-label">名</label>
                <input type="text" class="form-control" id="SearchGivenName" name="SearchGivenName" value="">
            </div>
        </div>
        <div class="row">
            <div class="form-inline">
                <button type="button" class="btn btn-primary" style="float:right" onclick="Search()">查詢</button>
                <button type="button" class="btn btn-success" style="float:right" onclick="Add()">新增</button>
            </div>
            <p></p>
        </div>

        @* Info List *@
        <table class="table table-striped" id="patientList" style="width: max-content; display: none">
            <thead style="vertical-align: middle;">
                <tr>
                    <th></th>
                    <th>病歷號</th>
                    <th>姓名</th>
                    <th>性別</th>
                    <th>身分證字號</th>
                    <th>生日</th>
                    <th>入院日期</th>
                    <th>出院日期</th>
                    <th>出院狀況</th>
                    <th>轉院院名</th>
                    <th>匯出FHIR</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div>
            <span id="noData" style="display: none">查無資料</span>
        </div>

        @* Insert/edit *@
        <div id="editForm" style="display: none">
            <div class="row" style="display: none">
                <div class="form-group col-md-12">
                    <label class="control-label">病歷號</label>
                    <input type="text" class="form-control" id="PatientId" name="PatientId" value="@PatientViewModel.PatientId">
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="control-label">姓</label>
                    <input type="text" class="form-control" id="FamilyName" name="FamilyName" value="@PatientViewModel.FamilyName">
                </div>
                <div class="form-group col-md-6">
                    <label class="control-label">名</label>
                    <input type="text" class="form-control" id="GivenName" name="GivenName" value="@PatientViewModel.GivenName">
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-3">
                    <label class="control-label">身分證字號</label>
                    <input type="text" class="form-control" id="IdNo" name="IdNo" value="@PatientViewModel.IdNo">
                </div>
                <div class="form-group col-md-3">
                    <label class="control-label">生日</label>
                    <input type="date" class="form-control" id="Birthday" name="Birthday" value="@(PatientViewModel.Birthday == DateTime.MinValue ? "" : PatientViewModel.Birthday.ToString("yyyy-MM-dd"))">
                </div>
                <div class="form-group col-md-3">
                    <label>性別</label>
                    @Html.DropDownList("group", GenderCodeList, "請下拉選單", new{ @class = "form-control", id = "Gender" })
                </div>
                <div class="form-group col-md-3">
                    <label class="control-label">聯絡電話</label>
                    <input type="text" class="form-control" id="Telecom" name="Telecom" value="@PatientViewModel.Telecom">
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-12">
                    <label class="control-label">住址</label>
                    <textarea class="form-control" rows="3" id="Address" name="Address">@PatientViewModel.Address</textarea>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-3">
                    <label class="control-label">入院日期</label>
                    <input type="date" class="form-control" id="AdmitDate" name="admitDate" value="@(PatientViewModel.AdmitDate == DateTime.MinValue ? "" : PatientViewModel.AdmitDate.ToString("yyyy-MM-dd"))" required>
                </div>
                <div class="form-group col-md-3">
                    <label class="control-label">出院日期</label>
                    <input type="date" class="form-control" id="DischargeDate" name="dischargeDate" value="@(PatientViewModel.DischargeDate == DateTime.MinValue ? "" : PatientViewModel.DischargeDate.ToString("yyyy-MM-dd"))" required>
                </div>
                <div class="form-group col-md-3">
                    <label class="control-label">出院狀況</label>
                    @Html.DropDownList("DischargeStatus", dischargeStatusOptions, new { @class = "form-control", onchange = "toggleTransferHospital(this.value)", id = "DischargeStatus" })
                    <div id="transferHospitalRow" class="form-group mt-2" style="display: @(PatientViewModel.DischargeStatus == "轉院" ? "block" : "none");">
                        <label class="control-label">轉院院名</label>
                        <input type="text" class="form-control" id="TransferHospital" name="transferHospital" value="@PatientViewModel.TransferHospital">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type ="button" class="btn btn-primary" id="submitButton" style="display: none" onclick="Submit()">儲存</button>
    </div>
</div>

<script>
        // 根據出院狀況顯示或隱藏轉院欄位
        function toggleTransferHospital(value) {
            const row = document.getElementById("transferHospitalRow");
            row.style.display = value === "轉院" ? "block" : "none";
        }
</script>
<script>
    
    function Search() {
        $.ajax({
            url: '@Url.Content("~/Patient/Search")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientId: document.getElementById("SearchPatientId").value,
                idNo: document.getElementById("SearchIdNo").value,
                familyName: document.getElementById("SearchFamilyName").value,
                givenName: document.getElementById("SearchGivenName").value,
                admitDate: document.querySelector('input[name="admitDate"]').value,
                dischargeDate: document.querySelector('input[name="dischargeDate"]').value,
                dischargeStatus: document.getElementById("DischargeStatus").value,
                transferHospital: document.querySelector('input[name="transferHospital"]') ? document.querySelector('input[name="transferHospital"]').value : ""
            },
            success: function (result) {
                if (Array.isArray(result) && result.length > 0) {
                    document.getElementById('patientList').style.display = "block";
                    document.getElementById('noData').style.display = "none";

                    SearchList(result);
                }
                else {
                    document.getElementById('patientList').style.display = "none";
                    document.getElementById('noData').style.display = "block";
                }
            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    };

    function SearchList(result) {
        var table = document.getElementById("patientList");
        
        if (table.rows.length > 1 ) {
            for (var i = 1; i < table.rows.length;) {
                table.deleteRow(i);
            }
        }

        for (let i = 0; i < result.length; i++) {
            var row = table.insertRow(i + 1);
            
            var cell1 = row.insertCell(0);
            var cell2 = row.insertCell(1);
            var cell3 = row.insertCell(2);
            var cell4 = row.insertCell(3);
            var cell5 = row.insertCell(4);
            var cell6 = row.insertCell(5);
            var cell7 = row.insertCell(6);
            var cell8 = row.insertCell(7);
            var cell9 = row.insertCell(8);
            var cell10 = row.insertCell(9);
            var cell11 = row.insertCell(10);

            cell1.innerHTML = `<button type="button" class="btn btn-warning" onClick="Update(` + result[i].patientId + ` ) ">修改</button>
                               <button type="button" class="btn btn-danger" onClick="Delete(` + result[i].patientId + `)">刪除</button>`;
            cell2.innerHTML = result[i].patientId;
            cell3.innerHTML = result[i].familyName + result[i].givenName;
            cell4.innerHTML = (result[i].gender == 'M') ? '男' : '女';
            cell5.innerHTML = result[i].idNo;
            cell6.innerHTML = new Date(result[i].birthday).toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
            cell7.innerHTML = new Date(result[i].admitDate).toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
            cell8.innerHTML = new Date(result[i].dischargeDate).toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
            cell9.innerHTML = result[i].dischargeStatus;
            cell10.innerHTML = result[i].transferHospital ? result[i].transferHospital : 'N/A';
            // 最右邊匯出FHIR按鈕
            cell11.innerHTML = `<button type="button" class="btn btn-info" onClick="ExportFHIR(` + result[i].patientId + `)">匯出FHIR</button>`;
        }
    };

    function Submit(){
        var admitDate = document.querySelector('input[name="admitDate"]').value;
        var dischargeDate = document.querySelector('input[name="dischargeDate"]').value;
        var dischargeStatus = document.getElementById("DischargeStatus").value;
        var transferHospitalInput = document.querySelector('input[name="transferHospital"]');
        var transferHospital = transferHospitalInput ? transferHospitalInput.value : "";
        if (dischargeStatus !== "轉院") {
            transferHospital = "";
        }
        
        var formData = {
            PatientId: document.getElementById("PatientId").value,
            IdNo: document.getElementById("IdNo").value,
            Active: true,
            FamilyName: document.getElementById("FamilyName").value,
            GivenName: document.getElementById("GivenName").value,
            Telecom: document.getElementById("Telecom").value,
            Gender: document.getElementById("Gender").value,
            Birthday: document.getElementById("Birthday").value,
            Address: document.getElementById("Address").value,
            AdmitDate: admitDate,
            DischargeDate: dischargeDate,
            DischargeStatus: dischargeStatus,
            TransferHospital: transferHospital
        }

        console.log('formData', formData);

        $.ajax({
            url: '@Url.Content("~/Patient/Save")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientViewModel: formData
            },
            success: function (result) {
                if (result) {
                    document.getElementById('editForm').style.display = "none";
                    document.getElementById('submitButton').style.display = "none";

                    Search();
                    alert("儲存成功");
                    return;
                }
                alert(result.Error);
            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    };

    function Add() {
        document.getElementById('editForm').style.display = "block";
        document.getElementById('submitButton').style.display = "block";

        document.getElementById("PatientId").value = 0;
        document.getElementById("FamilyName").value = "";
        document.getElementById("GivenName").value = "";
        document.getElementById("IdNo").value = "";
        document.getElementById("Birthday").value = new Date().toLocaleDateString('en-CA');
        document.getElementById("Gender").value = "";
        document.getElementById("Telecom").value = "";
        document.getElementById("Address").value = "";
        document.getElementById("AdmitDate").value = new Date().toLocaleDateString('en-CA');
        document.getElementById("DischargeDate").value = new Date().toLocaleDateString('en-CA');
        document.getElementById("DischargeStatus").value = "";
        toggleTransferHospital("");
    };
    function Update(id) {
        $.ajax({
            url: '@Url.Content("~/Patient/Search")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientId: id
            },
            success: function (result) {
                if (result) {
                    document.getElementById('editForm').style.display = "block";
                    document.getElementById('submitButton').style.display = "block";

                    document.getElementById("PatientId").value = result[0].patientId;
                    document.getElementById("FamilyName").value = result[0].familyName;
                    document.getElementById("GivenName").value = result[0].givenName;
                    document.getElementById("IdNo").value = result[0].idNo;
                    document.getElementById("Birthday").value = new Date(result[0].birthday).toLocaleDateString('en-CA');
                    document.getElementById("Gender").value = result[0].gender;
                    document.getElementById("Telecom").value = result[0].telecom;
                    document.getElementById("Address").value = result[0].address;
                    document.getElementById("AdmitDate").value = new Date(result[0].admitDate).toLocaleDateString('en-CA');
                    document.getElementById("DischargeDate").value = new Date(result[0].dischargeDate).toLocaleDateString('en-CA');
                    document.getElementById("DischargeStatus").value = result[0].dischargeStatus;
                    toggleTransferHospital(result[0].dischargeStatus);
                    if (result[0].dischargeStatus === "轉院") {
                        document.getElementById("TransferHospital").value = result[0].transferHospital;
                    }
                    return;
                }
                alert(result.message);
            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    };
    function Delete(id) {
       $.ajax({
            url: '@Url.Content("~/Patient/Delete")',
            method: 'POST',
            dataType: 'json',
            data: {
                patientId: id
            },
            success: function (result){
                if(result){
                    Search();
                    alert("刪除成功");
                    return;
                }
                alert(result.message);
            },
            error: function(err){
                alert(err.responseText);
            }
        });
    };

    function ExportFHIR(id) {
        // 直接用 GET 下載 FHIR JSON 檔
        window.location.href = '@Url.Content("~/Patient/ExportFHIR")' + '?patientId=' + id;
    }

</script>
